# Шаблон переменных окружения. Скопируйте в .env и заполните:
#   cp .env.example .env
# Файл .env не коммитится (см. .gitignore).

# Секретный ключ Django (для продакшена обязательно заменить и хранить в секрете!)
SECRET_KEY=django-insecure-change-me-in-production-!@#$%^&*()_+-=

# Режим отладки (True — только для разработки)
DEBUG=True

# Разделённый запятыми список допустимых хостов (для продакшена):
# ALLOWED_HOSTS=example.com,api.example.com

# Tinkoff Invest API (требуется реальный токен для загрузки акций и цен)
TINKOFF_TOKEN=

# PostgreSQL
DB_NAME=investing
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
# Заглушка Tinkoff API (True — тестовые данные, False — реальный API)
USE_TINKOFF_MOCK=False
